---
import Layout from "../layouts/Layout.astro";
import Brand from "../components/Brand.astro";
import Icon from "../components/Icon.astro";
import CopyCommand from "../components/CopyCommand.astro";
import WorkflowDemo from "../components/WorkflowDemo.astro";
import support from "../data/support.json";

const repo = "https://github.com/landoncrabtree/etymon";
const docs = `${repo}/blob/main/docs/CLI.md`;
const interfaces = [
  {
    name: "Skills",
    icon: "layers",
    text: "Local skills and skills.sh. Supporting files come along.",
    example: "etymon skills add vercel-labs/skills",
  },
  {
    name: "MCP",
    icon: "mcp",
    text: "Commands, HTTP, and SSE. Find servers in the MCP Registry.",
    example: "etymon mcp find",
  },
  {
    name: "Agents",
    icon: "agent",
    text: "Custom agents from your repo or a remote source.",
    example: "etymon agents create",
  },
  {
    name: "Rules",
    icon: "file",
    text: "Project instructions, nested guidance, and scoped rules.",
    example: "etymon rules create",
  },
];
---

<Layout>
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a class="home-link" href="#main" aria-label="Etymon home">
        <Brand />
      </a>
      <div class="nav-links">
        <a href="#workflow">Workflow</a>
        <a href="#interfaces">Interfaces</a>
        <a href="#tools">Tools</a>
      </div>
      <div class="nav-actions">
        <div
          class="theme-switch"
          role="group"
          aria-label="Color theme"
          data-themes
        >
          {["system", "light", "dark"].map((theme) => (
            <button
              type="button"
              data-theme-choice={theme}
              aria-label={`${theme[0].toUpperCase()}${theme.slice(1)} theme`}
              aria-pressed={theme === "system" ? "true" : "false"}
              title={`${theme[0].toUpperCase()}${theme.slice(1)} theme`}
            >
              <Icon
                name={
                  theme === "light"
                    ? "sun"
                    : theme === "dark"
                      ? "moon"
                      : "system"
                }
                size={17}
              />
            </button>
          ))}
        </div>
        <a
          class="github-link"
          href={repo}
          aria-label="Etymon on GitHub"
          title="Etymon on GitHub"
        >
          <svg
            viewBox="0 0 24 24"
            width="25"
            height="25"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.103.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.724 1.16 1.724 1.16 1.005 1.722 2.635 1.224 3.277.936.102-.728.393-1.224.715-1.506-2.499-.284-5.126-1.25-5.126-5.565 0-1.23.439-2.234 1.16-3.021-.116-.285-.502-1.43.11-2.98 0 0 .945-.303 3.094 1.155A10.78 10.78 0 0 1 12 6.177a10.77 10.77 0 0 1 2.813.378c2.149-1.458 3.092-1.155 3.092-1.155.614 1.55.228 2.695.112 2.98.722.787 1.158 1.791 1.158 3.021 0 4.327-2.631 5.278-5.138 5.557.404.35.766 1.043.766 2.102 0 1.517-.014 2.741-.014 3.113 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z" />
          </svg>
        </a>
      </div>
    </nav>
  </header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <h1 id="hero-title">
        <span>One setup.</span>
        <span>Every coding tool.</span>
      </h1>
      <div class="hero-aside">
        <p>
          Keep your skills, MCP servers, agents, and rules together. Take them
          to the tools you already use.
        </p>
        <div class="hero-actions">
          <CopyCommand id="hero-command" />
          <a class="text-link" href={docs}>
            Read the guide <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>
    <div class="demo-container">
      <WorkflowDemo />
    </div>
    <section
      class="interfaces container section"
      id="interfaces"
      aria-labelledby="interfaces-title"
    >
      <h2 id="interfaces-title">Bring the whole setup.</h2>
      <div class="interface-grid">
        {interfaces.map((item) => (
          <article class="interface">
            <h3>
              <Icon name={item.icon} size={32} />
              {item.name}
            </h3>
            <p>{item.text}</p>
            <a
              class="interface-action"
              href={`${docs}#${item.name === "MCP" ? "find-and-inspect" : item.name === "Agents" || item.name === "Rules" ? "create-a-resource" : "add-a-source"}`}
              aria-label={`${item.name} CLI reference`}
            >
              <code>{item.example}</code>
              <Icon name="arrow" size={18} />
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="shared-section section" aria-labelledby="shared-title">
      <div class="shared-layout container">
        <div class="shared-copy">
          <h2 id="shared-title">
            Stop keeping
            <br />
            copies in sync.
          </h2>
          <p>Different tools. Different files. The same project.</p>
          <p>
            Etymon gives your team one shared setup. Each contributor runs{" "}
            <code>etymon sync</code> for the tools they use.
          </p>
          <a class="text-link" href={`${repo}/blob/main/README.md`}>
            See the quick start <Icon name="arrow" size={18} />
          </a>
        </div>
        <div
          class="shared-diagram"
          aria-label="Tool-specific configuration becomes a shared manifest, lockfile, and authored resource folder"
        >
          <div class="native-file-list">
            <span>CLAUDE.md</span>
            <span>AGENTS.md</span>
            <span>opencode.json</span>
            <span>.cursor/rules/</span>
            <span>.mcp.json</span>
          </div>
          <div class="consolidate-arrow" aria-hidden="true">
            <Icon name="arrow" size={32} />
          </div>
          <div class="shared-file-list">
            <span>
              <Icon name="file" />
              etymon.toml
            </span>
            <span>
              <Icon name="lock" />
              etymon.lock
            </span>
            <span>
              <Icon name="folder" />
              etymon/
            </span>
            <p>
              Manifest, locked versions,
              <br />
              and your authored source.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section
      class="tools container section"
      id="tools"
      aria-labelledby="tools-title"
    >
      <div class="section-heading">
        <h2 id="tools-title">Bring your own tools.</h2>
        <a
          class="text-link"
          href={`${repo}/blob/main/README.md#supported-harnesses`}
        >
          Full support matrix <Icon name="arrow" size={18} />
        </a>
      </div>
      <p class="section-intro">
        CLI or editor. Work with the setup you already have.
      </p>
      <div class="tool-list">
        {support.map((tool) => (
          <span>{tool.label}</span>
        ))}
      </div>
      <p class="support-note">
        Support varies by tool and interface. Etymon flags anything a
        destination cannot preserve.
      </p>
    </section>
    <section
      class="get-started container section"
      aria-labelledby="start-title"
    >
      <div>
        <h2 id="start-title">
          Your next repo.
          <br />
          Already portable.
        </h2>
        <p>Start fresh, or bring your existing configuration.</p>
        <CopyCommand id="start-command" />
        <p class="install-alternative">
          Prefer a global install? <code>npm install -g etymon</code>
          <br />
          Node.js 22 or later.
        </p>
      </div>
      <div class="quick-start">
        <div>
          <span>New repository</span>
          <code>
            <span>$</span> etymon init
            <br />
            <span>$</span> etymon skills add vercel-labs/skills
            <br />
            <span>$</span> etymon sync
          </code>
        </div>
        <div>
          <span>Existing repository</span>
          <code>
            <span>$</span> etymon init
            <br />
            <span>$</span> etymon convert claude
            <br />
            <span>$</span> etymon sync
          </code>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer container">
    <a href="#main" aria-label="Back to Etymon home">
      <Brand />
    </a>
    <span>Open source. MIT licensed.</span>
    <div>
      <a href={docs}>CLI reference</a>
      <a href={`${repo}/blob/main/docs/CONTRIBUTING.md`}>Contribute</a>
      <a href={repo}>GitHub</a>
    </div>
  </footer>
</Layout>
